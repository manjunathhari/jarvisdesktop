{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/manjunathhari/jarvisdesktop/contracts/node-envelope.schema.json",
  "title": "Node message envelope",
  "description": "Wrapper for every message between a node (desktop, phone) and the gateway (spec §7.1). `sig` is Ed25519 over every other field: purpose `node-msg` from a node, `gw-transport` from the gateway. `seq` is a per-connection counter, strictly increasing. The payload shape for each kind is in messages/<kind>.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "message_id",
    "node_id",
    "seq",
    "sent_at",
    "kind",
    "payload",
    "sig"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "node_id": {
      "type": "string",
      "format": "uuid",
      "description": "The node's gw.node.id."
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "enum": [
        "enrol",
        "hello",
        "welcome",
        "utterance",
        "reply.chunk",
        "outbox.item",
        "outbox.cleared",
        "received",
        "ack",
        "approval.decision",
        "node.action",
        "action.receipt",
        "keyset",
        "ping",
        "pong",
        "error"
      ]
    },
    "payload": {
      "type": "object"
    },
    "sig": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "description": "Ed25519 signature, base64url without padding (64 bytes)."
    }
  }
}
