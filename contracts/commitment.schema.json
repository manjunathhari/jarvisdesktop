{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/manjunathhari/jarvisdesktop/contracts/commitment.schema.json",
  "title": "Commitment",
  "description": "Something someone has agreed or is expected to do (Architecture v2 \u00a710).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "person_id",
    "description",
    "state",
    "visibility",
    "source_ref",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "person_id": {
      "type": "string",
      "format": "uuid"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "due_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "event_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "state": {
      "enum": [
        "EXPECTED",
        "AT_RISK",
        "SECURED",
        "FULFILLED",
        "MISSED"
      ]
    },
    "visibility": {
      "enum": [
        "PRIVATE",
        "SELECTED_PERSON",
        "SELECTED_GROUP",
        "FAMILY_SHARED",
        "ORGANIZATION_SHARED"
      ]
    },
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
