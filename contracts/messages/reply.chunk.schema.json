{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/manjunathhari/jarvisdesktop/contracts/messages/reply.chunk.schema.json",
  "title": "Payload of `reply.chunk`",
  "description": "gateway → node: one chunk of a streamed reply. SPEECH carries `text` (authz null); ACTION carries `authz` (text null).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reply_id",
    "seq",
    "type",
    "text",
    "authz",
    "final",
    "in_reply_to"
  ],
  "properties": {
    "reply_id": {
      "type": "string",
      "format": "uuid"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "enum": [
        "SPEECH",
        "ACTION"
      ]
    },
    "text": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 4000
    },
    "authz": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "authz.schema.json"
        }
      ]
    },
    "final": {
      "type": "boolean"
    },
    "in_reply_to": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Unsigned (R12-37): the envelope `message_id` of the utterance this reply answers, so the node can tell its own answer from other replies of the person; null for a reply that answers no utterance (a result Jarvis reports on its own). A faulty gateway could only make the node ignore its answer, or follow another reply of the same person (its speech and its core-signed actions for this node); nothing unsigned authorises an action."
    }
  },
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "SPEECH"
        },
        "text": {
          "type": "string"
        },
        "authz": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "ACTION"
        },
        "text": {
          "type": "null"
        },
        "authz": {
          "type": "object"
        }
      }
    }
  ]
}
