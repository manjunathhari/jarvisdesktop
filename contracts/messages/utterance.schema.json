{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/manjunathhari/jarvisdesktop/contracts/messages/utterance.schema.json",
  "title": "Payload of `utterance`",
  "description": "node → gateway: what was heard, plus a short screen summary (§6.2).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text",
    "screen_summary"
  ],
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "screen_summary": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    }
  }
}
