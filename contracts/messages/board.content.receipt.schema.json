{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/manjunathhari/jarvisdesktop/contracts/messages/board.content.receipt.schema.json",
  "title": "Receipt of `board.content`",
  "description": "The `action.receipt` payload (its live form) for a `board.content` action. `STORED`: the node kept this chunk of this picture. `REFUSED`: a check failed and nothing changed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reply_id",
    "seq",
    "result",
    "evidence"
  ],
  "properties": {
    "reply_id": {
      "type": "string",
      "format": "uuid"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "result": {
      "enum": [
        "STORED",
        "REFUSED"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "index"
      ],
      "properties": {
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$",
          "description": "The picture's hash, as the args gave it."
        },
        "index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 63,
          "description": "The chunk's place, as the args gave it."
        },
        "check": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]{0,63}$",
          "description": "The check that failed. Omitted when there is none, never null."
        }
      },
      "description": "What the node stored or refused. Each of the two is null only when the args gave the node no usable value."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "STORED"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "sha256": {
                "type": "string"
              },
              "index": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  ]
}
