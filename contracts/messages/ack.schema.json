{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/manjunathhari/jarvisdesktop/contracts/messages/ack.schema.json",
  "title": "Payload of `ack`",
  "description": "node → gateway: the person has seen or acted on it. `{outbox_id}` for an outbox item, or `{reply_id, seq}` for every chunk of the reply up to `seq` (§8.2).",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outbox_id"
      ],
      "properties": {
        "outbox_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reply_id",
        "seq"
      ],
      "properties": {
        "reply_id": {
          "type": "string",
          "format": "uuid"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  ]
}
