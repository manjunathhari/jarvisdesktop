{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The JARVIS window may listen for events from Rust and call its own commands. The Board's commands are not among them, except opening the Board.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-tap",
    "allow-say",
    "allow-quit",
    "allow-video-failed",
    "allow-toggle-fullscreen",
    "allow-typed-input-enabled",
    "allow-needs-key",
    "allow-save-key",
    "allow-decide-approval",
    "allow-node-status",
    "allow-enrol",
    "allow-forget-claude-key",
    "allow-build-label",
    "allow-board-open"
  ]
}
